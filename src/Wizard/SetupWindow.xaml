<Window x:Class="Ros2Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROS 2 Humble Setup" Width="750" Height="700" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="17,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="85"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#142843" Padding="28,21">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" Foreground="White"
                           Text="ROS 2 Humble Setup"/>
                <TextBlock x:Name="Subtitle" Margin="0,4,0,0" Foreground="#DAE5F4"
                           Text="Windows 11 x64 · Humble Patch Release 14"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="BackClicked" Visibility="Collapsed"/>
                <Button x:Name="AbortButton" Content="Cancel" Click="AbortClicked"/>
                <Button x:Name="NextButton" Content="Review plan" Click="NextClicked" IsDefault="True"/>
            </StackPanel>
        </Border>
        <Grid Margin="27,20">
            <ScrollViewer x:Name="Settings" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Target="{Binding ElementName=Destination}" Padding="0" Content="Installation folder"/>
                    <TextBox x:Name="Destination" Padding="7,5" Margin="0,5,0,15"/>
                    <Label Target="{Binding ElementName=Dds}" Padding="0" Content="DDS backend"/>
                    <ComboBox x:Name="Dds" Padding="7,5" Margin="0,5,0,15">
                        <ComboBoxItem Content="Cyclone DDS  ·  RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"/>
                        <ComboBoxItem Content="Fast DDS  ·  RMW_IMPLEMENTATION=rmw_fastrtps_cpp"/>
                    </ComboBox>
                    <TextBlock FontWeight="SemiBold" Text="Optional components" Margin="0,0,0,7"/>
                    <CheckBox x:Name="WalkableOrReceiver" Content="Install WalkableOR Point Cloud Receiver"/>
                    <StackPanel Margin="20,0,0,12"
                                Visibility="{Binding IsChecked, ElementName=WalkableOrReceiver, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton x:Name="UseLocalProject" GroupName="ReceiverConfigSource"
                                     Content="Use a local walkableOR_unity project" Margin="0,0,0,6"/>
                        <StackPanel Margin="20,0,0,7"
                                    Visibility="{Binding IsChecked, ElementName=UseLocalProject, Converter={StaticResource BoolToVisibility}}">
                            <Label Target="{Binding ElementName=WalkableOrProject}" Padding="0" Content="walkableOR_unity project folder"/>
                            <DockPanel Margin="0,4,0,7">
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseProjectClicked"/>
                                <TextBox x:Name="WalkableOrProject" Padding="7,5"/>
                            </DockPanel>
                            <CheckBox x:Name="ReplaceWalkableOrConfig" Content="Replace an existing receiver configuration"
                                      Margin="0"/>
                        </StackPanel>
                        <RadioButton x:Name="DeferReceiverConfig" GroupName="ReceiverConfigSource"
                                     Content="I don’t have the project locally. I’ll supply the file later."/>
                    </StackPanel>
                    <CheckBox x:Name="Development" Content="C++ development tools"/>
                    <CheckBox x:Name="Visualization" Content="Qt visualization tools"/>
                    <CheckBox x:Name="Graphviz" Content="Graphviz for rqt_graph (includes Qt visualization)"/>
                    <CheckBox x:Name="OpenCv" Content="OpenCV examples"/>
                    <TextBlock FontWeight="SemiBold" Text="ROS command prompt shortcuts" Margin="0,5,0,7"/>
                    <CheckBox x:Name="StartMenu" Content="Start menu"/>
                    <CheckBox x:Name="Desktop" Content="Desktop"/>
                    <CheckBox x:Name="Transparency" Content="Transparency Mode" Margin="0,5,0,4"/>
                    <TextBlock Text="Confirm each installation step before it runs." TextWrapping="Wrap"/>
                    <TextBlock x:Name="SettingsError" Margin="0,12,0,0" Foreground="#962524" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <DockPanel x:Name="Details" Visibility="Collapsed">
                <TextBlock x:Name="Status" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="CurrentStepPanel" Margin="0,0,0,12">
                        <TextBlock Text="Current step" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="CurrentStepProgress" AutomationProperties.Name="Current step progress"
                                     Height="12" Minimum="0" Maximum="1" Margin="0,5,0,4"/>
                        <TextBlock x:Name="CurrentStepStatus" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Overall progress" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="OverallProgress" AutomationProperties.Name="Overall installation progress"
                                 Height="12" Minimum="0" Margin="0,5,0,4"/>
                    <TextBlock x:Name="OverallStatus"/>
                </StackPanel>
                <TextBox x:Name="Detail" IsReadOnly="True" TextWrapping="Wrap" Padding="12"
                         Background="White" BorderBrush="#CAD4E0" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
